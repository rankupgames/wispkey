class Wispkey < Formula
  desc "Local-first credential firewall for AI agents"
  homepage "https://github.com/rankupgames/wispkey"
  version "{{VERSION}}"
  license "Apache-2.0"

  on_macos do
    on_arm do
      url "{{BASE_URL}}/wispkey-aarch64-apple-darwin.tar.gz"
      sha256 "{{SHA_AARCH64_APPLE_DARWIN}}"
    end
    on_intel do
      url "{{BASE_URL}}/wispkey-x86_64-apple-darwin.tar.gz"
      sha256 "{{SHA_X86_64_APPLE_DARWIN}}"
    end
  end

  on_linux do
    on_arm do
      url "{{BASE_URL}}/wispkey-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "{{SHA_AARCH64_UNKNOWN_LINUX_GNU}}"
    end
    on_intel do
      url "{{BASE_URL}}/wispkey-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "{{SHA_X86_64_UNKNOWN_LINUX_GNU}}"
    end
  end

  def install
    bin.install "wispkey"
    doc.install "LICENSE"
    doc.install "README.md"
    doc.install "VERSION"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/wispkey --version")
  end
end
